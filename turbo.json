{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env", ".env.example", "packages/tsconfig/*.json"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "JWT_SECRET",
    "CORS_ORIGIN",
    "PORT",
    "HOST",
    "TRUST_PROXY",
    "DATABASE_MIGRATION_URL",
    "DATABASE_SSL_MODE",
    "DATABASE_SSL_CA_FILE",
    "DATABASE_POOL_MAX",
    "DATABASE_CONNECTION_TIMEOUT_MS",
    "DATABASE_IDLE_TIMEOUT_MS",
    "DATABASE_QUERY_TIMEOUT_MS",
    "AUTH_RATE_LIMIT_WINDOW_MS",
    "AUTH_RATE_LIMIT_MAX",
    "AUTH_RATE_LIMIT_MAX_KEYS",
    "AUTH_MAX_CONCURRENT_REQUESTS",
    "NEXT_PUBLIC_API_BASE_URL",
    "EXPO_PUBLIC_API_BASE_URL",
    "VITE_API_BASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "out/**", ".next/**", "!.next/cache/**"]
    },
    "@starter/ui#build": { "dependsOn": ["^build"], "outputs": [] },
    "@starter/project-ui#build": { "dependsOn": ["^build"], "outputs": [] },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "dev": { "cache": false, "persistent": true },
    "test": { "dependsOn": ["^build"], "outputs": [] }
  }
}
