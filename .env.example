# External PostgreSQL/Supabase is the default. Fill private DB URLs in ignored .env.
# For isolated local development use pnpm env:setup --database local.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
TRUST_PROXY=off
DATABASE_URL=
TEST_DATABASE_URL=
DATABASE_MIGRATION_URL=
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_CA_FILE=
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=5000
JWT_SECRET=
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_MAX_KEYS=10000
AUTH_MAX_CONCURRENT_REQUESTS=2
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,tauri://localhost,http://tauri.localhost
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
VITE_API_BASE_URL=http://localhost:4000/api/v1
SEED_USER_EMAIL=
