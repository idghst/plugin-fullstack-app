# Copy outside source control and provide credentials using deployment secrets.
NODE_ENV=production
PORT=4000
HOST=127.0.0.1
# Use loopback only when the API is reachable exclusively through a local trusted proxy.
TRUST_PROXY=off
DATABASE_URL=
DATABASE_MIGRATION_URL=
# Remote DB connections require certificate verification. Private loopback DB may use disable.
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_CA_FILE=
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=5000
JWT_SECRET=
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_MAX_KEYS=10000
AUTH_MAX_CONCURRENT_REQUESTS=2
CORS_ORIGIN=
NEXT_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_API_BASE_URL=
VITE_API_BASE_URL=
