{
  "name": "@starter/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "ios:release": "node scripts/run-production.mjs run:ios --configuration Release",
    "android:release": "node scripts/run-production.mjs run:android --variant release",
    "prebuild:release": "node scripts/run-production.mjs prebuild --no-install",
    "web": "expo start --web",
    "build": "expo export --platform all",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit"
  },
  "dependencies": {
    "@starter/config": "workspace:*",
    "@starter/api-client": "workspace:*",
    "@starter/auth": "workspace:*",
    "@starter/contracts": "workspace:*",
    "zod": "4.6.5",
    "expo": "57.0.26",
    "expo-router": "57.0.24",
    "expo-secure-store": "57.0.4",
    "expo-linking": "57.0.11",
    "expo-constants": "57.0.20",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "0.21.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.10.1",
    "react-native-reanimated": "4.5.1"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/react": "19.2.18",
    "typescript": "6.0.3"
  }
}
