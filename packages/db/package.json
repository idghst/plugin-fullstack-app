{
  "name": "@starter/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file=../../.env src/migrate.ts",
    "migrate:test": "tsx --env-file=../../.env src/migrate-test.ts",
    "seed": "tsx --env-file=../../.env src/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.18.0",
    "@types/node": "22.19.15",
    "drizzle-kit": "0.31.11",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  }
}
